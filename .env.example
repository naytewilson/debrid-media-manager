# Database Configuration
DATABASE_URL="mysql://username:password@host:port/database"

# DMM Configuration
DMM_ORIGIN=http://localhost:3000
DMMCAST_SALT=your-random-salt-here
# Signs the short-lived availability/torrents tokens minted by GET /api/challenge.
# Must be set before deploying: it replaces a salt that used to ship inside the
# browser bundle, where anyone could read it and forge a token. Any long random
# string. Generate with: openssl rand -hex 32
DMM_PROBLEM_SECRET=your-random-server-only-secret-here
REAL_DEBRID_OBSERVABILITY_SQLITE_PATH=.data/real-debrid-observability.sqlite
DMM_MAX_UNCACHED_LINKS=50

# Private Plex -> DMM -> Real-Debrid automation.
# Keep these server-side. The local poll/resolve endpoints require the bearer
# secret, while Plex and RD credentials never leave DMM.
# PLEX_ON_DEMAND_SECRET=<openssl-rand-hex-32>
# PLEX_ON_DEMAND_PLEX_TOKEN=<plex-account-token>
# PLEX_ON_DEMAND_RD_TOKEN=<real-debrid-api-token>
# PLEX_ON_DEMAND_ACCOUNT_ID=default
# PLEX_ON_DEMAND_PROFILE=quality
# First boot: baseline = ignore existing items, latest = resolve newest only,
# all = gradually resolve every existing movie.
# PLEX_ON_DEMAND_BOOTSTRAP=baseline
# Remove a successfully resolved movie from Plex Watchlist after RD accepts it.
# PLEX_ON_DEMAND_AUTO_REMOVE=false
# Optional release-corpus fallback. Defaults to https://debridmediamanager.com;
# set to off to require only local DMM/Debridio data.
# PLEX_ON_DEMAND_UPSTREAM_DMM_ORIGIN=https://debridmediamanager.com

# Request timeout in milliseconds
REQUEST_TIMEOUT=5000

# SOCKS5 Proxy (optional - used for stream proxying)
# PROXY=localhost:9050

# Debrid uploader service (TB -> RD transfers)
# One server:
# DEBRID_UPLOADER_URL=http://138.201.246.20:3100
# Or a pool (comma-separated) — jobs are spread round-robin and each is pinned
# to the server that created it for status polls/deletes. Add ;maxGb=N to cap an
# underpowered box so big torrents (remuxes/4K) skip it and land on a stronger one:
# DEBRID_UPLOADER_URLS=http://<debrid01-ip>:3100;maxGb=10,http://138.201.246.20:3100

# nzb2rd (Usenet -> RD) and the Newznab indexer backing the Usenet section on
# movie/show pages. Must be the Tailscale address: nzb2rd's public vhost serves
# only /webseed/*, so a public URL makes every submission 404.
# NZB2RD_URL=http://100.90.231.66:3200
# NEWZNAB_URL=https://drunkenslug.com/api
# NEWZNAB_API_KEY=your-drunkenslug-api-key
#
# Second indexer for the same section. Left unset it stays dormant and the page
# searches DrunkenSlug alone, so a half-filled config never queries a server as
# an anonymous user. The URL is the full API endpoint, not a host — these
# servers disagree on the path.
# ALTHUB_URL=https://api.althub.co.za/api
# ALTHUB_API_KEY=your-althub-api-key

# The sponsor-only Newznab endpoint (/api/newznab), which fans one *arr search
# out across the whole indexer fleet and answers as a single indexer.
#
# Every upstream it queries, as a JSON array. Separate from NEWZNAB_URL above:
# that pair backs the Usenet section of a media page, this one can carry the
# whole fleet without a code change. `prefix` is baked into every release id
# handed to a client and an *arr dedupes grabs by id, so changing one re-grabs
# everything — treat it as a stored value. `url` is the full API endpoint.
# `keyless: true` is for a server that searches without a key (AnimeTosho's .org
# mirror); an entry with neither a key nor that flag is dropped. `pacing` is the
# measured outbound quota, if one has been measured — an indexer over budget is
# skipped for that query rather than asked and refused, because an *arr turns a
# refusal into a day-long backoff. Leave it out when the quota is unknown: a
# guessed cap is worse than none. Falls back to the media-page indexers if unset.
# NEWZNAB_INDEXERS=[{"prefix":"ds","name":"DrunkenSlug","url":"https://drunkenslug.com/api","apiKey":"..."},{"prefix":"tm","name":"Treasure Maps","url":"https://treasure-maps.com/api","apiKey":"...","pacing":{"rateLimit":6,"windowSeconds":60}}]

# Encrypts the release ids that endpoint hands out, so a guid cannot be read
# back into "which indexer, which release" — that pair names the paid accounts
# DMM fans out to. 64 hex characters, server-side only. Unset, the endpoint
# refuses every request but caps. Rotating it invalidates every guid already
# issued, which makes an *arr re-grab its whole feed. Generate with:
# openssl rand -hex 32
# NEWZNAB_TOKEN_SECRET=

# The origin the NZB download links in that feed are built against. Never taken
# from the request's Host header: an *arr stores those links and replays them
# for days, so a request arriving on an internal hostname would otherwise mint
# links nothing outside the tailnet can reach. Defaults to production.
# NEWZNAB_PUBLIC_BASE=https://debridmediamanager.com

# Backblaze B2 bucket caching the NZBs that endpoint serves. An NZB is immutable
# once posted and the indexers meter downloads against one shared account, so
# only the first grab of a release costs an API call. Optional and never a
# source of truth — with these unset, or on any B2 failure, every grab simply
# goes upstream. Use an application key scoped to the one bucket.
# B2_KEY_ID=your-b2-application-key-id
# B2_APP_KEY=your-b2-application-key
# B2_BUCKET=your-b2-bucket-name

# Debridio torrent + RD-availability source (optional). The full addon config
# URL from https://debridio.com - the part before /manifest.json. It embeds a
# provider API key, so it stays server-side; leave unset to disable the
# integration. Each cache-miss listing spends that provider's instant-check
# quota, so prefer a test-account key over the main one.
# DEBRIDIO_ADDON_URL=https://addon.debridio.com/<realdebrid-config>
#
# Same shape for the AllDebrid variant: its ⚡ markers are written to
# AvailableAd. Both providers merge torrents into the same ScrapedTrue key.
# DEBRIDIO_ALLDEBRID_URL=https://addon.debridio.com/<alldebrid-config>

# Metadata APIs (optional)
# TMDB_KEY=your-tmdb-api-key
# OMDB_KEY=your-omdb-api-key
# MDBLIST_KEY=your-mdblist-api-key

# TMDB v4 read access token. A different credential from TMDB_KEY above, not a
# reformatting of it — TMDB rejects a v3 key sent as a bearer token. When set it
# takes precedence and every TMDB call authenticates by header instead of by
# api_key query parameter. Leave unset to keep using TMDB_KEY.
# TMDB_READ_TOKEN=your-tmdb-v4-read-access-token

# Simkl, used to resolve an anime's IMDb id from its kitsu/anidb/mal id. Every
# Simkl endpoint requires a client id, so without this the lookup is skipped
# rather than attempted. Register at https://simkl.com/settings/developer